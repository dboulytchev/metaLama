-- Parser 

import Ostap;
import Lexer;
import List;
import Array;
import Fun;
import Matcher;
import Ref;
import Collection;
import Grammar;
import STM;
import Expr;
import State;
import World;
import Quotator;


-- AST environment
fun createEnv (id, metaBindings) {
  fun freshName () {
    [createEnv (id+1, metaBindings), sprintf ("_tmp%d", id)]
  }

  fun addMetaBinding (name, value) {
    let metaBindings = 
      case findMap (metaBindings, name) of
        None     -> addMap (metaBindings, name, value)
      | Some (_) -> error (sprintf ("duplicate ""%s"" metaname definition", name), getLoc (name))
      esac in
    createEnv (id, metaBindings)
  }

  fun lookupMetaBinding (name) {
    case findMap (metaBindings, name) of
      None     -> error (sprintf ("meta name ""%s"" is undefined", name), getLoc (name))
    | Some (value) -> value
    esac
  }

  [freshName, addMetaBinding, lookupMetaBinding]
}

public fun emptyEnv () {
  createEnv (0, emptyMap (compare))
}

fun freshName (env) {
  env [0] ()
}

fun addMetaBinding (env, name, value) {
  env [1] (name, value)
}

fun lookupMetaBinding (env, name) {
  env [2] (name)
}

fun assertValue (atr, v, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> v => fun (v) { Ignore (v) }
  | _    -> v
  esac
}

fun assertVoid (atr, v, loc) {
  case atr of
    Void -> v
  | Val  -> error ("value expected", loc)
  | Weak -> v => fun (v) { Seq (v, Const(0)) }
  | _    -> error ("reference expected", loc)
  esac
}

fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binops (ops) {
  fun inner (ops) {
    case ops of 
      {} -> failure ("cannot create an expr without any operators")
    | op : {} -> 
      syntax (s[op])
    | op : tl ->  
      syntax (s[op] | inner[tl])
    esac
  }

  [inner (ops), fun (l, loc, r, op) {
    fun (a) {
      assertValue (a, l (Val) =>> fun (l) {
                      r (Val) => fun (r) {
                        Binop (op, l, r)
                      }}, loc)
    }
  }]
}

-- Helper parser: parses a (possible empty) list of items separated by ","
fun list0 (item) {
  list0By (item, s(","))
}

-- Helper parser: parses a non-empty list of items separated by ","
fun list (item) {
  listBy (item, s(","))
}

-- Helper AST function: expands a "raw" scope expression, reifying
-- initializers into assignments
fun expandScope (defs, expr) {
  fun expandVarDefs (defs, expr) {
    foldr (fun ([defs, expr], def) {     
             case def of
                [ident, None]         -> [ident : defs, expr]
             |  [ident, Some (value)] -> [ident : defs, Seq (Ignore (Set (ident, value)), expr)]
             esac
           },
           [{}, expr],
           defs)
  }

  fun expandValDefs (defs, expr) {
    foldr (fun ([defs, expr], [ident, value]) {     
             [ident : defs, Seq (Ignore (Set (ident, value)), expr)]
           },
           [{}, expr],
           defs)
  }
  
  case 
    foldr (fun ([defs, expr], def) {
             case def of
               f@Fun (_, _, _) -> [f : defs, expr]
             | Skip -> [defs, expr] 
             | Val (ds) ->
                 case expandValDefs (ds, expr) of
                   [ds, expr] -> [Val (ds) : defs, expr]
                 esac
             | Var (ds) ->             
                 case expandVarDefs (ds, expr) of
                   [ds, expr] -> [Var (ds) : defs, expr]
                 esac
             esac
           },
           [{}, expr],
           defs) of
    [defs, expr] -> Scope (defs, expr)
  esac  
}

-- Helper AST function: distributes a scope through an expression
fun distributeScope (expr, exprConstructor) {
  case expr of
    Scope (defs, sexpr) -> Scope (defs, exprConstructor (sexpr))
  | _                   -> exprConstructor (expr)
  esac
}

-- Helper AST function: reifies pattern bindings into scope
-- definitions and assignments; takes an returns lists of
-- pattern-branch pairs
fun reifyPatternBindings (matched, brs) {
  map (
    fun ([pat, br]) {      
      fun collectBindings (path, p) {
        fun collectList (path, ps) {
          case
            foldl (fun ([acc, i], p) {
                     [collectBindings (i : path, p) : acc, i+1]                      
                   },
                   [{}, 0],
                   ps) of
            [acc, _] -> flatten (acc)
          esac            
        }
        
        case p of
          Sexp  (_, ps)   -> collectList (path, ps)
        | Array (ps)      -> collectList (path, ps)
        | Named (name, p) -> [name, path] : collectBindings (path, p)
        |  _              -> {}
        esac
      }

      case collectBindings ({}, pat) of
        {}       -> [pat, br]
      | bindings ->
           [pat,
            expandScope (
              {Val (map (
                         fun ([name, path]) {
                              [name, foldr (fun (p, i) {Elem (p, Const (i))}, Var (matched), path)]
                         },
                         bindings))},
               br
             )]
      esac
    },
    brs
  )
}

-- Ostap patch

fun expr (ops, grammar, groupName, baseName) {
  case ops of
    {} -> grammar
  | [Left, newName, [ops, sema]] : tl  -> 
    let grammar = expr (tl, grammar, groupName, newName) in

    addEntry (grammar, groupName, After ("start", newName),
      eta syntax (loc=pos l=$(entry (grammar, groupName, newName))
                          op=ops
  			                  r=$(entry (grammar, groupName, baseName)) { sema (l, loc, r, op) } |
  							            $(entry (grammar, groupName, baseName))))

  | [Right, newName, [ops, sema]] : tl -> 
    let grammar = expr (tl, grammar, groupName, newName) in

    addEntry (grammar, groupName, After ("start", newName),
      eta syntax (        $(entry (grammar, groupName, baseName)) |
                loc=pos l=$(entry (grammar, groupName, baseName))
                        op=ops
  			                r=$(entry (grammar, groupName, newName)) { sema (l, loc, r, op) }))
  esac
}

-- Ostap patch end

-- Helpers for simple parser-rule language used in meta definitions.
-- A compiled rule value is [bindings, parser], where bindings is an
-- ordered list of names introduced by parser.
fun mkRuleUnnamed (p) {
  [{}, p @ fun (_) { {}}]
}

fun mkRuleNamed (name, p) {
  [{name}, p @ fun (x) { {[name, x]} }]
}

fun sameRuleBindings (left, right) {
  if left.size != right.size
  then false
  else case
         foldl (fun ([ok, i], name) {
                  [ok && name == right[i], i + 1]
                },
                [true, 0],
                left) of
         [ok, _] -> ok
       esac
  fi
}

fun mergeRuleBindings (left, right) {
  case
    foldl (fun ([seen, acc], name) {
             if memSet (seen, name)
             then failure (sprintf ("duplicate binding ""%s"" in sequential parser rule", name))
             else [addSet (seen, name), acc +++ {name}]
             fi
           },
           [foldl (addSet, emptySet (compare), left), left],
           right) of
    [_, merged] -> merged
  esac
}

fun combineRuleSeq (left, right) {
  case [left.fst, left.snd, right.fst, right.snd] of
    [leftBindings, leftParser, rightBindings, rightParser] ->
      [mergeRuleBindings (leftBindings, rightBindings),
       leftParser |> fun (leftValues) {
         rightParser @ fun (rightValues) {
           leftValues +++ rightValues
         }
       }]
  esac
}

fun combineRuleAlt (left, right) {
  case [left.fst, left.snd, right.fst, right.snd] of
    [leftBindings, leftParser, rightBindings, rightParser] ->
      if sameRuleBindings (leftBindings, rightBindings)
      then [leftBindings, leftParser | rightParser]
      else failure ("all alternatives must bind identical names")
      fi
  esac
}

fun combineRuleOpt (rule) {
  case [rule.fst, rule.snd] of
    [bindings, parser] ->
      [bindings,
       opt (parser) @ fun (res) {
         case res of
           None ->
             map (fun (name) {
                    [name, fun (a) { returnST $ None }]
                  },
                  bindings)
         | Some (res) ->
             map (fun ([name, value]) {
                    [name, fun (a) {
                      value (Val) => fun (value) {
                        Some (value)
                      }
                    }]
                  },
                  res)
         esac
       }]
  esac
}

fun combineRuleRep0 (rule) {
  case [rule.fst, rule.snd] of
    [bindings, parser] ->
      [bindings,
       rep0 (parser) @ fun (reps) {
         case
           foldl (fun ([acc, i], name) {
                    [acc +++ {[name, fun (a) {
                      chainST (map (resolveRuleBindings, reps)) => fun (reps) {
                        map (fun (rep) { rep[i].snd }, reps)
                      }
                    }]},
                     i + 1]
                  },
                  [{}, 0],
                  bindings) of
           [acc, _] -> acc
         esac
       }]
  esac
}

fun wrap (parser) {
  parser @ fun (x) {
    fun (a) {
      returnST $ x
    }
  }
}

fun resolveLexerRuleParser (parserName) {
  case parserName of
    "lident"  -> wrap (lident)
  | "uident"  -> wrap (uident)
  | "strlit"  -> wrap (strlit)
  | "chrlit"  -> wrap (chrlit)
  | "decimal" -> wrap (decimal)
  | "pos"     -> wrap (pos)
  | "end"     -> wrap (end)
  | _         -> failure (sprintf ("unknown lexer primitive ""%s""", parserName))
  esac
}

fun compileRule (g, gn, rule) {
  case rule of
    RuleRef (groupName, levelName) ->
      mkRuleUnnamed (entry (g, groupName, levelName))
  | RuleLexerRef (parserName) ->
      mkRuleUnnamed (resolveLexerRuleParser (parserName))
  | RuleToken (token) ->
      mkRuleUnnamed (wrap (s (token)))
  | RuleBind (name, groupName, levelName) ->
      mkRuleNamed (name, entry (g, groupName, levelName))
  | RuleLexerBind (name, parserName) ->
      mkRuleNamed (name, resolveLexerRuleParser (parserName))
  | RuleTokenBind (name, token) ->
      mkRuleNamed (name, wrap (s (token)))
  | RuleSeq (left, right) ->
      combineRuleSeq (compileRule (g, gn, left), compileRule (g, gn, right))
  | RuleAlt (left, right) ->
      combineRuleAlt (compileRule (g, gn, left), compileRule (g, gn, right))
  | RuleOpt (rule) ->
      combineRuleOpt (compileRule (g, gn, rule))
  | RuleRep0 (rule) ->
      combineRuleRep0 (compileRule (g, gn, rule))
  esac
}

fun addRuleBindings (state, bindings) {
  foldl (fun (state, [name, value]) {
           state.addName (name, Val (value))
         },
         state,
         bindings)
}

fun chainBindingsST (xs) {
  fun (state) {
    case
      foldl (fun (f, [name, x]) {
               fun (state) {
                 case f (state) of
                   [state, xs] -> case x (state) of
                                  [state, x] -> [state, [name, x] : xs]
                                esac
                 esac
               }
             }, returnST $ {}, xs) (state) of    
      [state, xs] -> [state, reverse (xs)]
    esac
  }
}

fun makeConsList (xs) {
  case xs of
    {}      -> Nil
  | x : tl  -> Cons (x, makeConsList (tl))
  esac
}

fun unmakeConsList (xs) {
  case xs of
    Nil -> {}
  | Cons (x, tl) -> x : unmakeConsList (tl)
  esac
}

fun resolveRuleBindings (bindings) {
  chainBindingsST (map (fun ([name, value]) {
                 [name, value (Val)]
               },
               bindings))
}

fun constructParser () {
  let g = createGrammar ("test") in
  addGroup (g, "expr");
  addEntry (g, "expr", After ("start", "primary"), eta syntax (
    -- array constant
    loc=pos x=inbr[s("["), list0(syntax (e=$(entry (g, "expr", "start")) {e(Val)})), s("]")] {
      fun (a) {assertValue (a, chainST (x) => fun (x) {Array (x)}, loc)}
    } |

    -- string constant
    loc=pos x=strlit {
      fun (a) {assertValue (a, returnST $ String (x), loc)}
    } |

    -- character literal
    loc=pos x=chrlit {
      fun (a) {assertValue (a, returnST $ Const (x), loc)}
    } |

    -- decimal constant
    loc=pos x=decimal {
      fun (a) {assertValue (a, returnST $ Const (stringInt (x)), loc)}
    } |

    -- identifier
    loc=pos x=lident { 
      fun (a) {
        returnST $ case a of
                     Ref  -> Ref (x)
                   | Void -> Ignore (Var (x))
                   | _    -> Var (x)
                   esac
        }
    } |

    -- S-expression
    loc=pos x=uident {fun (a) {assertValue (a, returnST $ Sexp (x, {}), loc)}} |

    -- Lambda-function
    kFun args=$(entry (g, "expr", "funArgs")) body=$(entry (g, "expr", "funBody")) {
      fun (a) { 
        args (Void) =>> fun (args) {
        body (Weak) => fun (body) {
          Lambda (args, body)
        }}
      }
    } |

    -- skip
    loc=pos kSkip {
      fun (a) {assertVoid (a, returnST $ Skip, loc)}
    } |

    -- while e do b
    loc=pos kWhile e=$(entry (g, "expr", "start")) b=inbr[kDo, syntax($(entry (g, "expr", "scopeExpr"))), kOd] {
      fun (a) {
        assertVoid (a, e (Val)  =>> fun (e) {
                       b (Void) =>  fun (b) {
                         While (e, b)
                       }},
                    loc)
      }
    } |

    -- do s while e
    loc=pos kDo s=$(entry (g, "expr", "scopeExpr")) kWhile e=$(entry (g, "expr", ":=")) kOd {
      fun (a) {
        assertVoid (a, s (Void) =>> fun (s) {
                       e (Val)  =>  fun (e) {
                         distributeScope (s, fun (s) {DoWhile (s, e)})
                       }},
                    loc)
      }
    } |

    -- for init, cond, step do S od --> init; while cond do S; step od
    loc=pos kFor init=$(entry (g, "expr", "scopeExpr")) s[","] cond=$(entry (g, "expr", "start")) s[","] step=$(entry (g, "expr", "start")) body=inbr[kDo, syntax($(entry (g, "expr", "scopeExpr"))), kOd] {
      fun (a) {
        assertVoid (a, init (Void) =>> fun (init) {
                       cond (Val)  =>> fun (cond) {
                       body (Void) =>> fun (body) {
                       step (Void) =>  fun (step) {
                         distributeScope (init, fun (init) {Seq (init, While (cond, Seq (body, step)))})
                       }}}},
                     loc)
      }
    } |

    -- if ...
    -kIf $(entry (g, "expr", "ifPart")) -kFi |

    -- case
    -kCase loc=pos c=$(entry (g, "expr", "start")) -kOf brs=$(entry (g, "expr", "caseBranches")) -kEsac {
      fun (a) {
        c (Val) =>> fun (c) {
        chainST $ map (fun ([p, b]) {fun (env) {case b (a) (env) of [env, b] -> [env, [p, b]] esac}}, brs) =>> fun (brs) {
          fun (env) {
            case env.freshName of
              [env, matched] ->
                [env, expandScope ({Val ({[matched, c]})},
                                   Case (matched, reifyPatternBindings (matched, brs), loc)
                      )
                ]
            esac}}}
      }} |

    -- unqoutation
    s["!${"] res=$(entry (g, "expr", "start")) s["}"] {
      fun (a) { 
        res (Val) => fun (res) { Unqoute (res) }
      }
    }  |

    -- ( e )
    inbr[s ("("), syntax($(entry (g, "expr", "scopeExpr"))), s (")")] 
    ));

  addEntry (g, "expr", After ("start", "funArgs"), eta syntax (
    args=inbr[s("("), list0 (syntax($(entry (g, "expr", "primary")))), s(")")] {
      fun (a) {
        let args = map (fun (arg) {arg (Val)}, args) in
        chainST (args) => fun (args) {
          args
        }
      }
    }
  ));

  addEntry (g, "expr", After ("start", "funBody"), eta syntax (
    body=inbr[s("{"), syntax($(entry (g, "expr", "scopeExpr"))), s("}")] {
      fun (a) {
        body (Weak) => fun (body) {
          body
        }
      }
    }
  ));

  addEntry (g, "expr", After ("start", "elsePart"), eta syntax (
    loc=pos {
      fun (a) {assertVoid (a, returnST $ Skip, loc)}
    }
  | -kElse $(entry (g, "expr", "scopeExpr"))
  | -kElif $(entry (g, "expr", "ifPart"))
  ));

  addEntry (g, "expr", After ("start", "thenPart"), eta syntax (-kThen $(entry (g, "expr", "scopeExpr"))));

  addEntry (g, "expr", After ("start", "ifPart"), eta syntax (
    cond=$(entry (g, "expr", "start")) th=$(entry (g, "expr", "thenPart")) el=$(entry (g, "expr", "elsePart")) {
      fun (a) {cond (Val) =>> fun (cond) {
               th   (a)   =>> fun (th)   {
               el   (a)   =>  fun (el)   {
                 If (cond, th, el)
              }}}}
    }
  ));

  addEntry (g, "expr", After ("start", "pattern"), eta syntax (
    c=chrlit                                                                              {Const (c[0])}                                                           |
    s=strlit                                                                              {String (s)}                                                             |
    x=decimal                                                                             {Const (stringInt (x))}                                                  |
    s["_"]                                                                                {Wildcard}                                                               |
    c=uident args=inbr[s ("("), list (syntax($(entry (g, "expr", "pattern")))), s (")")]? {Sexp (c, case args of Some (args) -> args | None -> {} esac)}           |
    a=inbr[s ("["), list0 (syntax($(entry (g, "expr", "pattern")))), s ("]")]             {Array (a)}                                                              |
    x=lident p=(-s["@"] $(entry (g, "expr", "pattern")))?                                 {case p of Some (p) -> Named (x, p) | None -> Named (x, Wildcard) esac } |
    inbr[s ("("), syntax($(entry (g, "expr", "pattern"))), s (")")]
  ));

  addEntry (g, "expr", After ("start", "caseBranches"), eta syntax (
    listBy [syntax ($(entry (g, "expr", "pattern")) -s["->"] $(entry (g, "expr", "scopeExpr"))), s ("|")]
  ));

  expr ({
      [Left,  "*",  binops ({"*", "/", "%"})],
      [Left,  "+",  binops ({"+", "-"})],
      [Left,  "==", binops ({"==", "!=", "<", ">", "<=", ">="})],
      [Left,  "&&", binops ({"&&"})],
      [Left,  "!!", binops ({"!!"})],
      [Right, ":=", [s (":="), 
                     fun (l, loc, r, op) {
                       fun (a) { assertValue (a, l (Ref) =>> fun (l) {
                                                 r (Val) => fun (r) {
                                                   Assn (l, r)
                                                 }}, loc) }
                     }]]
  }, g, "expr", "postfix");

  addEntry (g, "expr", After ("start", "postfix"), eta syntax (
    loc=pos e=$(entry (g, "expr", "primary")) ps=(i=inbr[s("["), syntax ($(entry (g, "expr", "start"))), s("]")]                              {Index (i (Val))} |
                          -s["."] kLength                                          {Length}          |
                          args=inbr[s("("), list0(syntax(e=$(entry (g, "expr", "start")) {e(Val)})), s(")")] {Call (args)})* {
      fun (a) {
        foldl (fun (e, p) {                                                                            
                 case p of                                                                                   
                   Length    -> fun (a) {assertValue (a, e (Val) => fun (e) {Builtin ("length", {e})}, loc)}
                 | Index (i) ->
                    fun (a) {
                      case a of
                        Ref -> e (Val) =>> fun (e) {
                               i       =>  fun (i) {
                                 ElemRef (e, i)
                               }} 
                      | _   -> assertValue (a, e (Val) =>> fun (e) {
                                               i       =>  fun (i) {
                                                 Elem (e, i)
                                               }},
                                            loc)
                      esac
                    }
                 | Call (args) ->
                    fun (a) {
                      assertValue (a, e (Val)        =>> fun (e) {
                                      chainST (args) =>  fun (args) {
                                        case e of
                                          Sexp (t, {}) -> Sexp (t, args)
                                        | _            -> Call (e, args, loc)
                                        esac
                                      }}, loc)
                    }
                 esac                                                                            
               }, e, ps) (a)
      }}
  ));

  addEntry (g, "expr", After ("start", "scopeExpr"), eta syntax (
    ds=$(eta (entry (g, "expr", "definition")))* e=$(entry (g, "expr", "start"))? {
    fun (a) {
      fun (e) {
        case ds of
          {} -> e
        | _  -> let ds = map (fun (def) {def (Void)}, ds) in
                chainST (ds) =>> fun (ds) {
                e            =>  fun (e)  {
                  expandScope (ds, e)
                }}
        esac
      }
      (case e of 
        Some (e) -> e (a)
      | _        -> returnST $ Skip
      esac)
    }}
  ));

  addGroup (g, "syntax");

  addEntry (g, "syntax", After ("start", "ruleUnnamed"), eta syntax (
    s["["] groupName=strlit s[","] levelName=strlit s["]"] {
      case groupName of 
        "LEXER" -> RuleLexerRef (levelName)
      | _       -> RuleRef (groupName, levelName)
      esac
    } |
    token=inbr[s ("s["), strlit, s ("]")] {
      RuleToken (token)
    } 
  ));

  addEntry (g, "syntax", After ("start", "ruleNamed"), eta syntax (
    name=lident s["="] s["["] groupName=strlit s[","] levelName=strlit s["]"] {
      case groupName of 
        "LEXER" -> RuleLexerBind (name, levelName)
      | _       -> RuleBind (name, groupName, levelName)
      esac
    } |
    name=lident s["="] token=inbr[s ("s["), strlit, s ("]")] {
      RuleTokenBind (name, token)
    }
  ));

  addEntry (g, "syntax", After ("start", "ruleAtom"), eta syntax (
    $(entry (g, "syntax", "ruleNamed")) |
    $(entry (g, "syntax", "ruleUnnamed")) |
    inbr[s ("("), syntax($(entry (g, "syntax", "rule"))), s (")")]
  ));

  addEntry (g, "syntax", After ("start", "rulePostfix"), eta syntax (
    atom=$(entry (g, "syntax", "ruleAtom")) suffix=(s["?"] { Opt } | s["*"] { Rep0 })? {
      case suffix of
        Some (Opt)  -> RuleOpt (atom)
      | Some (Rep0) -> RuleRep0 (atom)
      | None        -> atom
      esac
    }
  ));

  addEntry (g, "syntax", After ("start", "ruleAnd"), eta syntax (
    l=$(entry (g, "syntax", "rulePostfix")) r=(-s["|>"] $(entry (g, "syntax", "ruleAnd")))? {
      case r of
        Some (r) -> RuleSeq (l, r)
      | None     -> l
      esac
    }
  ));

  addEntry (g, "syntax", After ("start", "ruleOr"), eta syntax (
    l=$(entry (g, "syntax", "ruleAnd")) r=(-s["|"] $(entry (g, "syntax", "ruleOr")))? {

      case r of
        Some (r) -> RuleAlt (l, r)
      | None     -> l
      esac
    }
  ));

  addEntry (g, "syntax", After ("start", "rule"), eta syntax (
    $(entry (g, "syntax", "ruleOr"))
  ));

  addGroup (g, "position");

  addEntry (g, "position", At ("start"), eta syntax (
    s["At"] lName=inbr[s ("("), strlit, s (")")] {
      At (lName)
    } |
    s["Before"] s["("] target=strlit s[","] newName=strlit s[")"] {
      Before (target, newName)
    } |
    s["After"] s["("] target=strlit s[","] newName=strlit s[")"] {
      After (target, newName)
    }
  ));

  addEntry (g, "expr", After ("start", "definition"), eta syntax (
    kVar ds=list[syntax (x=lident e=(-s["="] $(entry (g, "expr", ":=")))? {case e of
                                                        None -> returnST $ [x, None]
                                                      | Some (e) ->
                                                          e (Val) => fun (e) {[x, Some (e)]}
                                                      esac})] s[";"] {
      fun (a) { chainST (ds) => fun (ds) {Var (ds)} }
    } |
    kVal ds=list[syntax (x=lident s["="] e=$(entry (g, "expr", ":=")) {e (Val) => fun (e) {[x, e]}})] s[";"] {
      fun (a) { chainST (ds) => fun (ds) {Val (ds)} }
    } |
    kFun name=lident args=$(entry (g, "expr", "funArgs")) body=$(entry (g, "expr", "funBody")) {
      fun (a) { 
        args (Void) =>> fun (args) {
        body (Weak) => fun (body) {
          Fun (name, args, body)
        }}
      }
    } |
    -- meta entry
    s["meta"] gn=strlit pos=$(entry (g, "position", "start")) s[":"]
    def=$(entry (g, "syntax", "rule"))
    metaBody=inbr[s("{"), syntax($(entry (g, "expr", "scopeExpr"))), s("}")] {
        addGroup (g, gn);
        let [_, parser] = compileRule (g, gn, def) in
        addEntry (g, gn, pos, eta syntax (
          bindings=parser {
            fun (a) {
              metaBody (Weak) =>> fun (metaBody) {
              resolveRuleBindings (bindings) =>> fun (bindings) {
              fun (env) {
                var locEnv = ref (env);
                let p = eval ([addRuleBindings (
                                 emptyState ().enterScope
                                 .addFunction ("write", {"a"}, Preproc (fun ({a}) { printf ("%s\n", a.string) }))
                                 .addFunction ("freshName", {}, Preproc (fun (_) {
                                   case deref (locEnv).freshName of
                                     [locEnvNew, name] -> locEnv ::= locEnvNew; Var (name)
                                   esac
                                 }))
                                 .addFunction ("addMetaBinding", {"name", "value"}, Preproc (fun ({name, value}) {
                                   locEnv ::= deref (locEnv).addMetaBinding (name, value)
                                 }))
                                 .addFunction ("lookupMetaBinding", {"name"}, Preproc (fun ({name}) {
                                   deref (locEnv).lookupMetaBinding (name)
                                 }))
                                 .addFunction ("makeConsList", {"xs"}, Preproc (fun ({xs}) {
                                   makeConsList (xs)
                                 }))
                                 .addFunction ("unmakeConsList", {"xs"}, Preproc (fun ({xs}) {
                                   unmakeConsList (xs)
                                 }))
                                 .addFunction ("expandScope", {"ds", "expr"}, Preproc (fun ({ds, expr}) {
                                   expandScope (ds, expr)
                                 })),
                               bindings),
                               createWorld ({})], metaBody).snd in
                [deref (locEnv), p]
              }}}
            }
          }
        ));
        fun (a) { returnST $ Skip }
    }
  ));

  addEntry (g, "expr", At ("start"), eta syntax (
    $(entry (g, "expr", ":="))
  | s1=$(entry (g, "expr", ":=")) s[";"] s2=$(entry (g, "expr", "start")) {
     fun (a) {
       s1 (Void) =>> fun (s1) {
       s2 (a)    =>  fun (s2) {
         Seq (s1, s2)
       }}
     }
   }
  ));

  syntax ($(entry (g, "expr", "scopeExpr")))
}

-- Public top-level parser
public parse = constructParser ();