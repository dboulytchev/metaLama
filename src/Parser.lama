-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;
import Ref;
import Collection;
import Grammar;
import STM;

-- -- Signals an error; takes an error message and location info
public fun error (msg, loc) {
  failure ("%s at %d:%d\n", msg, loc.fst, loc.snd)
}

-- AST environment
fun createEnv (id) {
  fun freshName () {
    [createEnv (id+1), sprintf ("_tmp%d", id)]
  }

  [freshName]
}

public fun emptyEnv () {
  createEnv (0)
}

fun freshName (env) {
  env [0] ()
}

fun assertValue (atr, v, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> v => fun (v) { Ignore (v) }
  | _    -> v
  esac
}

fun assertVoid (atr, v, loc) {
  case atr of
    Void -> v
  | Val  -> error ("value expected", loc)
  | _    -> error ("reference expected", loc)
  esac
}

fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binops (ops) {
  fun inner (ops) {
    case ops of 
      {} -> failure ("cannot create an expr without any operators")
    | op : {} -> 
      syntax (s[op])
    | op : tl ->  
      syntax (s[op] | inner[tl])
    esac
  }

  [inner (ops), fun (l, loc, r, op) {
    fun (a) {
      assertValue (a, l (Val) =>> fun (l) {
                      r (Val) => fun (r) {
                        Binop (op, l, r)
                      }}, loc)
    }
  }]
}

-- Ostap patch

fun expr (ops, grammar, groupName, baseName) {
  case ops of
    {} -> grammar
  | [Left, newName, [ops, sema]] : tl  -> 
    let grammar = expr (tl, grammar, groupName, newName) in

    addEntry (grammar, groupName, After ("start", newName),
      eta syntax (loc=pos l=$(entry (grammar, groupName, newName))
                          op=ops
  			                  r=$(entry (grammar, groupName, baseName)) { sema (l, loc, r, op) } |
  							            $(entry (grammar, groupName, baseName))))

  | [Right, newName, [ops, sema]] : tl -> 
    let grammar = expr (tl, grammar, groupName, newName) in

    addEntry (grammar, groupName, After ("start", newName),
      eta syntax ($(entry (grammar, groupName, baseName)) |
        loc=pos l=$(entry (grammar, groupName, baseName))
                op=ops
  			        r=$(entry (grammar, groupName, newName)) { sema (l, loc, r, op) }))
  esac
}

-- Ostap patch end

fun constructParser () {
  let g = createGrammar ("test") in
  let g = addGroup (g, "expr") in
  let g = addEntry (g, "expr", After ("start", "primary"), eta syntax (loc=pos x=decimal {fun (a) { assertValue (a, returnST $ Const (stringInt (x)), loc) }}             |
                                                                       x=lident  {fun (a) {
                                                                            returnST $ case a of
                                                                                         Ref  -> Ref (x)
                                                                                       | Void -> Ignore (Var (x))
                                                                                       | _    -> Var (x)
                                                                                       esac
                                                                                    }}                           |
                                                                       inbr[s("("), syntax($(entry (g, "expr", "start"))), s(")")] |
 
                    loc=pos kRead x=inbr[s("("), lident, s(")")] { fun(a) { assertVoid(a, returnST $ Read(x), loc) } } |
                    loc=pos kWrite e=inbr[s("("), syntax($(entry (g, "expr", "start"))), s(")")] { fun(a) { assertVoid(a, e (Val) => fun (e) {
                                                                                                                            Write (e)
                                                                                                                          } , loc)} } |
                    loc=pos kSkip {fun(a) { assertVoid(a, returnST $ Skip, loc) }} |
                    loc=pos kIf e=$(entry (g, "expr", "start")) 
                      kThen s1=$(entry (g, "expr", "start")) 
                    end=$(entry (g, "expr", "endIf")) {
                      fun (a) {
                        e(Val) =>> fun (e) {s1(a) =>> fun (s1) {end(a) => fun (end) {If(e, s1, end)}}}
                      }
                    } |
                    loc=pos kWhile e=$(entry (g, "expr", "start")) kDo s=$(entry (g, "expr", "start")) kOd {fun(a) { assertVoid(a, e (Val) =>> fun (e) {
                                                                                                                                   s (Void) => fun (s) {    
                                                                                                                                     While(e, s) 
                                                                                                                                   }}, loc) }} |
                    loc=pos kDo s=$(entry (g, "expr", "start")) kWhile e=$(entry (g, "expr", "start")) kOd {fun(a) { assertVoid(a, s (Void) =>> fun (s) {
                                                                                                                                   e (Val) => fun (e) {    
                                                                                                                                     DoWhile(s, e) 
                                                                                                                                   }}, loc) }} |
                    kFor s1=$(entry (g, "expr", "start")) s[","] cond=$(entry (g, "expr", "start")) s[","] s2=$(entry (g, "expr", "start")) kDo s=$(entry (g, "expr", "start")) kOd {
                      fun(a) {
                        s1 (Void) =>> fun (s1) {
                        cond (Val) =>> fun (cond) {
                        s (Void) =>> fun (s) {
                        s2 (Void) => fun (s2) {
                          Seq(s1, While (cond, Seq(s, s2)))
                        }}}}}
                    }                
                    ))
  in
  let g = expr ({
      [Left,  "*",  binops ({"*", "/", "%"})],
      [Left,  "+",  binops ({"+", "-"})],
      [Left,  "==", binops ({"==", "!=", "<", ">", "<=", ">="})],
      [Left,  "&&", binops ({"&&"})],
      [Left,  "!!", binops ({"!!"})],
      [Right, ":=", [s (":="), 
                     fun (l, loc, r, op) {
                       fun (a) { assertValue (a, l (Ref) =>> fun (l) {
                                                 r (Val) => fun (r) {
                                                   Assn (l, r)
                                                 }}, loc) }
                     }]]
  }, g, "expr", "primary") in
  let g = addEntry (g, "expr", After ("start", "endIf"), eta syntax ( 
                        kFi { fun (a) {
                          assertVoid(a, returnST $ Skip, loc)
                        }} |
                        kElse s=$(entry (g, "expr", "start")) kFi { fun (a) {
                          s(a)
                        }} |
                        kElif e=$(entry (g, "expr", "start")) kThen s=$(entry (g, "expr", "start")) end=$(entry (g, "expr", "endIf")) {
                          fun (a) {
                            e(Val) =>> fun (e) {s(a) =>> fun (s) {end(a) => fun (end) { If(e, s, end) }}}
                          }
                        })) in
  let g = addEntry (g, "expr", At ("start"), eta syntax ($(entry (g, "expr", ":=")) |
                                                       l=$(entry (g, "expr", ":=")) s[";"] r=$(entry (g, "expr", "start")) { fun (a) { l (Void) =>> fun (l) {
                                                                                                                                       r (a) => fun (r) {
                                                                                                                                         Seq (l, r)        
                                                                                                                                       }}}}))
  in

  syntax ($(entry (g, "expr", "start")))
}

-- Public top-level parser
public parse = constructParser ();