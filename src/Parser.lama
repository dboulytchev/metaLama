-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;
import Ref;
import Collection;
import Grammar;

-- -- Signals an error; takes an error message and location info
public fun error (msg, loc) {
  failure ("%s at %d:%d\n", msg, loc.fst, loc.snd)
}

fun assertValue (atr, v, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> Ignore (v)
  | _    -> v
  esac
}

fun assertVoid (atr, v, loc) {
  case atr of
    Void -> v
  | Val  -> error ("value expected", loc)
  | _    -> error ("reference expected", loc)
  esac
}

fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun constructParser () {
  let g = createGrammar ("test") in
  let g = addGroup (g, "expr") in
  let g = addEntry (g, "expr", After ("start", "primary"), eta syntax (loc=pos x=decimal {fun (a) { assertValue (a, Const (stringInt (x)), loc) }}             |
                                                                       x=lident  {fun (a) {
                                                                                       case a of
                                                                                         Ref  -> Ref (x)
                                                                                       | Void -> Ignore (Var (x))
                                                                                       | _    -> Var (x)
                                                                                       esac
                                                                                    }}                           |
                                                                       inbr[s("("), syntax($(entry (g, "expr", "start"))), s(")")] |
 
                    loc=pos kRead x=inbr[s("("), lident, s(")")] { fun(a) { assertVoid(a, Read(x), loc) } } |
                    loc=pos kWrite e=inbr[s("("), syntax($(entry (g, "expr", "start"))), s(")")] { fun(a) { assertVoid(a, Write(e(Val)), loc)} } |
                    loc=pos kSkip {fun(a) { assertVoid(a, Skip, loc) }} |
                    loc=pos kIf e=$(entry (g, "expr", "start")) 
                      kThen s1=$(entry (g, "expr", "start")) 
                    elf=(-kElif $(entry (g, "expr", "start")) 
                      -kThen $(entry (g, "expr", "start")))* 
                    s2=(-kElse $(entry (g, "expr", "start")))? kFi {
                                    fun helper (final, elf, type) {
                                      case elf of
                                      {} -> final
                                      | [e, s]:elf -> If (e(Val), s(type), helper(final, elf, type))
                                      esac
                                    }
                                    fun(a) { 
                                      If(e(Val), s1(a), helper (
                                        case s2 of
                                          None -> assertVoid (a, Skip, loc)
                                          | Some (s) -> s(a)
                                        esac, 
                                        elf, a))
                                      }
                                    } |
                    loc=pos kWhile e=$(entry (g, "expr", "start")) kDo s=$(entry (g, "expr", "start")) kOd {fun(a) { assertVoid(a, While(e(Val), s(Void)), loc) }} |
                    loc=pos kDo s=$(entry (g, "expr", "start")) kWhile e=$(entry (g, "expr", "start")) kOd {fun(a) { assertVoid(a, DoWhile(s(Void), e(Val)), loc) }} |
                    kFor s1=$(entry (g, "expr", "start")) s[","] cond=$(entry (g, "expr", "start")) s[","] s2=$(entry (g, "expr", "start")) kDo s=$(entry (g, "expr", "start")) kOd {
                      fun(a) {Seq(s1(Void), While (cond(Val), Seq(s(Void), s2(Void))))}
                    }                
                    ))
  in
  let g = addEntry (g, "expr", After ("start", "*"), eta syntax (loc=pos l=$(entry (g, "expr", "*")) op=(s["*"] |
                                                                                                 s["/"] |
  									                                                                             s["%"])
  			                                                                 r=$(entry (g, "expr", "primary")) { fun (a) { assertValue (a, Binop (op, l (Val), r (Val)), loc) } } |
  							                                                           $(entry (g, "expr", "primary"))))
  in
  let g = addEntry (g, "expr", After ("start", "+"), eta syntax (loc=pos l=$(entry (g, "expr", "+")) op=(s["+"] |
                                                                                               s["-"])
  			                                                                 r=$(entry (g, "expr", "*")) { fun (a) { assertValue (a, Binop (op, l (Val), r (Val)), loc) } } |
  							                                                           $(entry (g, "expr", "*"))))
  in
  let g = addEntry (g, "expr", After ("start", "=="), eta syntax ($(entry (g, "expr", "+")) |
                                                        loc=pos l=$(entry (g, "expr", "+")) op=(s["=="] |
  				 	                                                                                    s["!="] |
                                                                                                s["<="] |
  								  		                                                                        s["<" ] |
  								  		                                                                        s[">="] |
  										                                                                          s[">" ])
  						                                                  r=$(entry (g, "expr", "+")) { fun (a) { assertValue (a, Binop (op, l (Val), r (Val)), loc) } })) 
  in  
  let g = addEntry (g, "expr", After ("start", "&&"), eta syntax ($(entry (g, "expr", "==")) |
                                                        loc=pos l=$(entry (g, "expr", "==")) op=s["&&"] r=$(entry (g, "expr", "&&")) { fun (a) { assertValue (a, Binop (op, l (Val), r (Val)), loc) } }))                                                  						   
  in
  let g = addEntry (g, "expr", After ("start", "!!"), eta syntax ($(entry (g, "expr", "&&")) |
                                                        loc=pos l=$(entry (g, "expr", "&&")) op=s["!!"] r=$(entry (g, "expr", "!!")) { fun (a) { assertValue (a, Binop (op, l (Val), r (Val)), loc) } }))
  in 
  let g = addEntry (g, "expr", After ("start", ":="), eta syntax ($(entry (g, "expr", "!!")) |
                                                        loc=pos l=$(entry (g, "expr", "!!")) s[":="] r=$(entry (g, "expr", ":=")) { fun (a) { assertValue (a, Assn (l (Ref), r (Val)), loc) } }))
  in
  let g = addEntry (g, "expr", At ("start"), eta syntax ($(entry (g, "expr", ":=")) |
                                                       l=$(entry (g, "expr", ":=")) s[";"] r=$(entry (g, "expr", "start")) { fun (a) {Seq (l (Void), r (a))} }))
  in
  syntax ($(entry (g, "expr", "start")))
}

-- Public top-level parser
public parse = constructParser ();