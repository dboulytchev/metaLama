var a, b;

meta "expr" At ("primary") : s["eta"] |> e=":=" {
    var x = freshName ();
    ${expr: fun (!${x}) { !${e} (!${x}) } }
}

fun makeLazy (f) {
  fun () {
    f ()
  } 
}

meta "expr" At ("primary") : s["lazy"] |> e=":=" {
    ${expr: makeLazy (fun () { !${e} })}
}

meta "expr" At ("primary") : s["leta"] |> e=":=" {
  ${expr: lazy eta !${e}}
}

meta "expr" At ("definition") : 
s["method"] |> 
(name="lident" |> args="funArgs" |> body="funBody") {
  Fun (name, args, body)
}

method mwrite (a) {
  write (a)
}

a := leta mwrite;
b := lazy 5;

a () (b ())