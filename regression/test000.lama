var a, b;

meta "expr" "primary" : "eta" e=metaExprVal {
    var x = freshName ();
    ${expr: fun (!${x}) { !${e} (!${x}) } }
}

fun makeLazy (f) {
  fun () {
    f ()
  } 
}

meta "expr" "primary" : "lazy" e=metaExprVal {
    ${expr: makeLazy (fun () { !${e} })}
}

meta "expr" "primary" : "leta" e=metaExprVal {
  ${expr: lazy eta !${e}}
}

meta "expr" "definition" : "method" name=lident |> args=methodArgs |> body=methodBody {
  Fun (name, args, body)
}

method mwrite (a) {
  write (a)
}

a := leta mwrite;
b := lazy 5;

a () (b ())